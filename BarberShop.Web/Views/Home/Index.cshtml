@{
    ViewData["Title"] = "Seu próximo corte";
}
<header class="header">
    <a class="brand" href="#" aria-label="Navalha Barbearia, início"><span class="brand-icon">✂</span><span>NAVALHA<small>BARBEARIA & ESTILO</small></span></a>
    <nav aria-label="Navegação principal"><a href="#servicos">Serviços</a><a href="#equipe">Nossa equipe</a><a href="#sobre">A barbearia</a><a href="/Home/Login">Entrar</a></nav>
    <a class="header-cta" href="#agenda">Agendar horário <span>↗</span></a>
</header>
<main>
    <section class="hero">
        <div class="hero-copy"><p class="eyebrow"><span></span> SEU ESTILO, NOSSO OFÍCIO</p><h1>Um bom corte.<br>Uma nova <em>versão.</em></h1><p class="hero-description">Mais que cabelo e barba. Um tempo para você.<br>Escolha seu estilo e deixe o resto com a gente.</p><a class="button primary" href="#agenda">Encontre seu horário <span>↗</span></a><div class="social-proof"><div class="avatar-stack"><span>R</span><span>M</span><span>J</span></div><div><span class="stars">★★★★★</span><p><strong>4,9/5</strong> de quem já sentou na cadeira</p></div></div></div>
